# ProxiSpeak Environment Variables

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# WebSocket URL for real-time data streaming (CSV processing / proximity updates)
VITE_WS_URL=ws://localhost:5000/ws

# Toggle Mock Mode: Set to true when backend is offline or in development
VITE_USE_MOCK_DATA=true

# Optional Map Tile Provider (default falls back to free OpenStreetMap)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
