# ---------------------------------------------------------------------------
# ProxiSpeak backend environment template.
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# HTTP / Socket.IO listen port (1-65535)
PORT=5000

# MongoDB connection string (mongodb:// or mongodb+srv://)
MONGO_URI=mongodb://127.0.0.1:27017/proxispeak

# Redis pub/sub for the Socket.IO adapter (multi-instance scaling).
# Set REDIS_ENABLED=false to force the single-instance in-memory adapter.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

# Allowed CORS origin(s). Comma-separated list, or * for any.
# NOTE: credentials are disabled automatically when this is '*'.
CORS_ORIGIN=*

# Virtual-office proximity radius in the same units as coordinates (pixels).
PROXIMITY_RADIUS=100

# --- Optional session lifecycle (defaults shown) ---
# How often the janitor deactivates sessions whose socket is gone (ms).
SESSION_SWEEP_INTERVAL_MS=60000
# Backstop TTL for session documents not refreshed within this window (seconds).
SESSION_TTL_SECONDS=86400
