VITE_USE_MOCK_DATA=false
VITE_API_BASE_URL=http://localhost:5000/api

# WebSocket URL for real-time data streaming (CSV processing / proximity updates)
VITE_WS_URL=ws://localhost:5000/ws

# Toggle Mock Mode: Set to true when backend is offline or in development
VITE_USE_MOCK_DATA=true

# Optional Map Tile Provider (default falls back to free OpenStreetMap)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# ---------------------------------------------------------------------------
# ProxiSpeak backend environment template.
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# HTTP / Socket.IO listen port (1-65535)
PORT=5000

# MongoDB connection string (mongodb:// or mongodb+srv://)
MONGO_URI=mongodb://127.0.0.1:27017/proxispeak

# Redis pub/sub for the Socket.IO adapter (multi-instance scaling).
# Set REDIS_ENABLED=false to force the single-instance in-memory adapter.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

# Allowed CORS origin(s). Comma-separated list, or * for any.
# NOTE: credentials are disabled automatically when this is '*'.
CORS_ORIGIN=*

# Virtual-office proximity radius in the same units as coordinates (pixels).
PROXIMITY_RADIUS=100

# --- Optional session lifecycle (defaults shown) ---
# How often the janitor deactivates sessions whose socket is gone (ms).
SESSION_SWEEP_INTERVAL_MS=60000
# Backstop TTL for session documents not refreshed within this window (seconds).
SESSION_TTL_SECONDS=86400
# Per-socket token-bucket limits (tokens per second).
RATE_LIMIT_POSITION_PER_SEC=30
RATE_LIMIT_SIGNAL_PER_SEC=60
